---

<Layout
  title="Arjunagi A. Rehman — Backend & AI Systems Engineer"
  description="I build AI systems that survive production — production agents, real-time platforms, and distributed systems, from 0→1 through production. Based in Bangalore."
  currentPath="/"
  ogType="website"
  structuredData={[personSchema, websiteSchema]}
>

  <!-- ── HERO ── -->
  <section class="hero">
    <div class="container hero-inner">
      <div class="hero-content">
        <div class="hero-greeting" style="animation-delay:0.1s">
          <span class="hero-greeting-line" aria-hidden="true"></span>
          <span class="hero-greeting-text">Hello, I'm Arjunagi Rehman</span>
        </div>

        <h1 class="hero-headline">
          I build AI systems<br />
          that <span class="hero-headline-accent">survive production.</span>
        </h1>

        <div class="hero-label" style="animation-delay:0.45s">
          Backend &amp; AI Systems Engineer
        </div>

        <p class="hero-desc" style="animation-delay:0.6s">
          Building production agents, real-time platforms and distributed
          systems — from <span class="highlight">0→1</span> through
          <span class="highlight">production</span>.
        </p>

        <div class="hero-ctas" style="animation-delay:0.75s">
          <a href="#projects" class="btn btn-primary">
            <span>View Selected Work</span>
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
          <a href="/agent" class="btn btn-outline">
            Ask My AI
          </a>
        </div>

        <div class="hero-stats" style="animation-delay:0.9s">
          <div class="stat">
            <span class="stat-num">10+</span>
            <span class="stat-label">Production systems</span>
          </div>
          <div class="stat-divider"></div>
          <div class="stat">
            <span class="stat-num">5+</span>
            <span class="stat-label">AI deployments</span>
          </div>
          <div class="stat-divider"></div>
          <div class="stat">
            <span class="stat-num">BIAL</span>
            <span class="stat-label">Production deployment</span>
          </div>
          <div class="stat-divider"></div>
          <div class="stat">
            <span class="stat-num">4+ yrs</span>
            <span class="stat-label">Backend systems</span>
          </div>
        </div>
      </div>

      <!-- Hero co-hero: live agent terminal. -->
      <!-- noscript fallback below renders when JS is disabled — keeps the column from collapsing. -->
      <div class="hero-terminal">
        <noscript>
          <div class="hero-terminal-noscript">
            <strong>Ask the agent →</strong>
            JavaScript disabled. Email instead:
            <a href="mailto:contact@arjunagiarehman.com">contact@arjunagiarehman.com</a>
            <br /><br />
            Or visit <a href="/agent">/agent</a> with JS enabled.
          </div>
        </noscript>
        <AgentChat
          client:idle
          variant="hero"
          surface="home-hero"
          mcpServerUrl={mcpServerUrl}
          contactEmail={contactEmail}
        />
      </div>
    </div>

    <!-- Hero bottom decorative line -->
    <div class="hero-bottom-bar">
      <div class="hero-bottom-line"></div>
    </div>
  </section>

  <!-- ── SELECTED WORK ── -->
  <section class="projects-section" id="projects">
    <div class="container">
      <div class="section-label">Selected Work</div>
      <h2 class="section-title">Systems that <span class="gradient-text">shipped</span></h2>
      <p class="section-sub">Production systems and experiments — what they do, who uses them, and how they're built.</p>

      <div class="featured-work">
        {featuredProjects.map((project, i) => {
          const num = String(i + 1).padStart(2, '0');
          const inner = (
            <>
              <div class="fw-index" aria-hidden="true">{num}</div>
              <div class="fw-body">
                <div class="fw-top">
                  <h3 class="fw-name">{project.name}</h3>
                  <span class="fw-proof">
                    <span class="fw-proof-dot" aria-hidden="true"></span>
                    {project.proof}
                  </span>
                </div>
                <p class="fw-tagline">{project.tagline}</p>
                <p class="fw-detail">{project.detail}</p>
                <div class="fw-footer">
                  <span class="fw-tags">{project.tags.join(' · ')}</span>
                  {project.detailPage ? (
                    // Real anchor: keyboard-focusable, open-in-new-tab works,
                    // and navigation survives with JS disabled. The row-level
                    // click handler stays as a mouse-only enhancement.
                    <a
                      href={project.detailPage}
                      class="fw-cta"
                      aria-label={`${project.cta}: ${project.name}`}
                      onclick="event.stopPropagation()"
                    >
                      {project.cta}
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                    </a>
                  ) : (
                    // Row itself is the anchor in this branch — a nested <a>
                    // would be invalid HTML.
                    <span class="fw-cta">
                      {project.cta}
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                    </span>
                  )}
                </div>
              </div>
              {project.detailPage && (
                <div class="fw-actions">
                  {project.github && (
                    <a href={project.github} target="_blank" rel="noopener" class="project-action-btn" aria-label={`${project.name} on GitHub`} onclick="event.stopPropagation()">
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/></svg>
                    </a>
                  )}
                  {project.link && (
                    <a href={project.link} target="_blank" rel="noopener" class="project-action-btn" aria-label={`${project.name} live site`} onclick="event.stopPropagation()">
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M18 13v6a2 2 0 01-2 2H5a2 2 0 01-2-2V8a2 2 0 012-2h6M15 3h6v6M10 14L21 3"/></svg>
                    </a>
                  )}
                </div>
              )}
            </>
          );
          return project.detailPage ? (
            <article
              class="fw-row has-detail"
              style={`animation-delay:${i * 0.08}s`}
              data-detail={project.detailPage}
            >
              {inner}
            </article>
          ) : (
            <a
              href={project.github}
              target="_blank"
              rel="noopener"
              class="fw-row"
              style={`animation-delay:${i * 0.08}s`}
            >
              {inner}
            </a>
          );
        })}
      </div>

      <div class="rest-label"><span>More projects &amp; experiments</span></div>
      <div class="projects-grid rest-grid">
        {projects.map((project, i) => {
          const detailPage = project.detailPage;
          return (
          <article class={`project-card compact card${detailPage ? ' has-detail' : ''}`} style={`animation-delay:${i * 0.08}s`} data-detail={detailPage || ''}>
            <div class="project-card-top">
              <div class="project-type-badge" data-type={project.type}>
                <span class="type-dot"></span>
                {project.type}
              </div>
              {project.badge && (
                <span class="project-live-badge">{project.badge}</span>
              )}
              <div class="project-actions">
                {project.github && (
                  <a href={project.github} target="_blank" rel="noopener" class="project-action-btn" aria-label={`${project.name} on GitHub`} onclick="event.stopPropagation()">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/></svg>
                  </a>
                )}
                {project.link && (
                  <a href={project.link} target="_blank" rel="noopener" class="project-action-btn" aria-label={`${project.name} live site`} onclick="event.stopPropagation()">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M18 13v6a2 2 0 01-2 2H5a2 2 0 01-2-2V8a2 2 0 012-2h6M15 3h6v6M10 14L21 3"/></svg>
                  </a>
                )}
              </div>
            </div>
            <h3 class="project-name">{project.name}</h3>
            <p class="project-desc">{project.description}</p>
            <div class="project-tags">
              {project.tags.slice(0, 5).map(t => <span class="tag">{t}</span>)}
            </div>
            {detailPage && (
              <div class="project-detail-cta">
                <span>View case study</span>
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
              </div>
            )}
          </article>
          );
        })}
      </div>

      {displayRepos.length > 0 && (
        <div class="repos-grid">
          {displayRepos.map((repo) => (
            <a href={repo.html_url} target="_blank" rel="noopener" class="repo-card card">
              <div class="repo-top">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="var(--text-dim)"><path d="M3 3h18v18H3V3zm16 16V5H5v14h14zM7 7h10v2H7V7zm0 4h10v2H7v-2zm0 4h7v2H7v-2z"/></svg>
                <span class="repo-name">{repo.name}</span>
              </div>
              {repo.description && <p class="repo-desc">{repo.description}</p>}
