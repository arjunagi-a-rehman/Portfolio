<script>
  import { navigate } from 'astro:transitions/client';

  // Top-level state that survives across SPA swaps (this module runs once).
  // On each navigation we tear down the previous observer so they don't pile
  // up — otherwise a user who clicks Home five times would have five
  // observers running simultaneously.
  let scrollObserver: IntersectionObserver | undefined;

  document.addEventListener('astro:before-swap', () => {
    if (scrollObserver) {
      scrollObserver.disconnect();
      scrollObserver = undefined;
    }
  });

  document.addEventListener('astro:page-load', () => {
    // Intersection observer for scroll animations
    scrollObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('in-view');
            scrollObserver?.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.1 }
    );

    requestAnimationFrame(() => {
      document.querySelectorAll('.project-card, .repo-card, .writing-row, .fw-row').forEach((el) => {
        scrollObserver?.observe(el);
      });
    });

    // Clickable project cards with detail pages. Use the router's navigate()
    // instead of window.location.href so the destination also swaps in-place
    // (no white flash between home and /projects/*).
    document.querySelectorAll('.has-detail[data-detail]').forEach((card) => {
      const detail = (card as HTMLElement).dataset.detail;
      if (detail) {
        (card as HTMLElement).style.cursor = 'pointer';
        card.addEventListener('click', () => {
          navigate(detail);
        });
      }
    });
  });
</script>

