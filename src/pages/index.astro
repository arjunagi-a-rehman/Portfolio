// JSON-LD: Person schema
const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Arjunagi A. Rehman',
  url: 'https://arjunagiarehman.com/',
  image: 'https://arjunagiarehman.com/logo.svg',
  jobTitle: 'Backend & AI Systems Engineer',
  description:
    'Backend & AI systems engineer building production AI agents, real-time platforms, and distributed systems — from 0→1 through production.',
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Bangalore',
    addressCountry: 'IN',
  },
  sameAs: [
    'https://github.com/arjunagi-a-rehman',
    'https://www.linkedin.com/in/arjunagi-a-rehman-moulaali/',
  ],
  knowsAbout: [
    'Go',
    'Python',
    'AWS',
    'LangGraph',
    'Google ADK',
    'FastAPI',
    'IoT',
    'AI Agents',
    'Real-time Systems',
  ],
};

// JSON-LD: WebSite schema
const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Arjunagi A. Rehman — Portfolio',
  url: 'https://arjunagiarehman.com/',
  author: { '@type': 'Person', name: 'Arjunagi A. Rehman' },
  description:
