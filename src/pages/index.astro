    badge: '3 Live Services',
  },
  {
    name: 'GormAuditLog',
    description:
      'Open-source Go library for ORM-level audit logging with GORM. Tracks create/update/delete events with minimal configuration overhead.',
    tags: ['Go', 'GORM', 'Open Source', 'MySQL', 'PostgreSQL'],
    link: null,
    github: 'https://github.com/arjunagi-a-rehman/gormAuditlog',
    type: 'Open Source',
  },
  {
    name: 'School Agents',
    description:
      'Config-driven AI tutoring agent built with Google ADK and Gemini — YAML-defined agent, markdown prompts, dynamic tool loading, calculator and Google Search tools. Companion repo to the AI Agent System blog series.',
    tags: ['Google ADK', 'Python', 'Gemini', 'LLM', 'Education'],
